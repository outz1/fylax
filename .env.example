# Copie para .env (nunca commite o .env).
POSTGRES_USER=fylax
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fylax
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://fylax:troque-esta-senha@127.0.0.1:5432/fylax?schema=public
REDIS_URL=redis://127.0.0.1:6379
API_HOST=127.0.0.1
API_PORT=3001

# Fase 1: escopo e rede
# Redes do lab (as linhas `route` do .ovpn são somadas). Ex.: HTB = 10.129.0.0/16; lab local = 10.250.0.0/24
# Sem nenhuma rede aqui nem no .ovpn, o worker recusa todo scan (falha fechada).
LAB_CIDRS=
# Faixas EXTRAS da sua LAN, bloqueio absoluto do Scope Guard (somadas a 192.168.0.0/16 e 172.16.0.0/12)
FYLAX_LAN_CIDRS=
